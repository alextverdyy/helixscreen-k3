<?xml version="1.0" encoding="utf-8"?>
<!-- SPDX-License-Identifier: GPL-3.0-or-later -->
<component>
  <consts>
    <px name="motion_z_col_w_micro" value="54"/>
    <px name="motion_z_col_w_tiny" value="64"/>
    <px name="motion_z_col_w_small" value="64"/>
    <px name="motion_z_col_w_medium" value="64"/>
    <px name="motion_z_col_w_large" value="64"/>
    <px name="bed_map_marker_size_micro" value="10"/>
    <px name="bed_map_marker_size_tiny" value="12"/>
    <px name="bed_map_marker_size_small" value="14"/>
    <px name="bed_map_marker_size_medium" value="16"/>
    <px name="bed_map_marker_size_large" value="20"/>
    <px name="bed_map_inset_micro" value="5"/>
    <px name="bed_map_inset_tiny" value="6"/>
    <px name="bed_map_inset_small" value="7"/>
    <px name="bed_map_inset_medium" value="8"/>
    <px name="bed_map_inset_large" value="10"/>
    <px name="bed_map_home_size_micro" value="44"/>
    <px name="bed_map_home_size_tiny" value="52"/>
    <px name="bed_map_home_size_small" value="60"/>
    <px name="bed_map_home_size_medium" value="72"/>
    <px name="bed_map_home_size_large" value="88"/>
    <px name="motion_mode_row_h_micro" value="26"/>
    <px name="motion_mode_row_h_tiny" value="28"/>
    <px name="motion_mode_row_h_small" value="48"/>
    <px name="motion_mode_row_h_medium" value="52"/>
    <px name="motion_mode_row_h_large" value="72"/>
    <px name="motion_mode_row_h_xlarge" value="80"/>
    <px name="motion_mode_row_h_xxlarge" value="96"/>
    <color name="k3_selected" value="0x3B2B6D"/>
  </consts>
  <subjects>
    <subject_expr name="motion_z_keys_stacked" expr="ui_breakpoint ge 2"/>
  </subjects>
  <styles>
    <style name="axis_letter_homed" text_color="#primary"/>
    <style name="axis_value_homed" text_color="#text"/>
    <style name="axis_unhomed" text_color="#text_muted"/>
    <style name="coords_swap_actual" text_color="#primary"/>
    <style name="coords_swap_commanded" text_color="#text_muted"/>
    <style name="k3_step_selected" bg_color="#k3_selected"/>
    <style name="k3_step_unselected" bg_color="#elevated_bg"/>
  </styles>
  <view name="motion_panel"
        extends="lv_obj" width="#overlay_width_transient" height="100%" align="right_mid"
        style_pad_left="14" style_pad_right="14" style_pad_top="10" style_pad_bottom="16"
        style_pad_gap="12" style_border_width="0" style_bg_opa="255" style_bg_color="#screen_bg"
        scrollable="false" flex_flow="column">
    <header_bar name="overlay_header"
                title="Motion" hide_action_icon="false" action_icon="cog" action_icon_hidden_cond="ui_breakpoint lt 2"
                action_icon_callback="on_motion_header_settings_clicked">
      <header_bar-header_content>
        <lv_obj name="header_tabs"
                width="content" height="100%" style_pad_all="0" style_pad_left="#space_sm" style_bg_opa="0"
                style_border_width="0" scrollable="false" clickable="false" flex_flow="row" style_pad_gap="#space_xs"
                style_flex_cross_place="center" style_flex_track_place="center">
          <zone_tab label_subject="motion_tab_label_0"
                    active_subject="motion_tab_active_0" tab_index="0" icon="cursor_move" hide_label="true"
                    ext_click_area="6" callback="on_motion_tab_clicked" selected_style="zone_tab_pill_selected"
                    content_selected_style="zone_tab_on_primary" idle_style="zone_tab_pill_idle"/>
          <zone_tab label_subject="motion_tab_label_1"
                    active_subject="motion_tab_active_1" tab_index="1" icon="crosshairs_gps" hide_label="true"
                    ext_click_area="6" callback="on_motion_tab_clicked" selected_style="zone_tab_pill_selected"
                    content_selected_style="zone_tab_on_primary" idle_style="zone_tab_pill_idle"/>
          <zone_tab name="header_tab_bed"
                    label_subject="motion_tab_label_2" active_subject="motion_tab_active_2" tab_index="2"
                    icon="grid_large" hide_label="true" ext_click_area="6" callback="on_motion_tab_clicked"
                    selected_style="zone_tab_pill_selected" content_selected_style="zone_tab_on_primary"
                    idle_style="zone_tab_pill_idle" moves_machine="true"/>
        </lv_obj>
        <lv_obj name="header_coords"
                width="content" height="100%" hidden="true" style_pad_all="0" style_bg_opa="0"
                style_border_width="0" scrollable="false" clickable="false" flex_flow="row">
          <lv_label name="header_pos_x" bind_text="motion_pos_x"/>
          <lv_label name="header_pos_y" bind_text="motion_pos_y"/>
          <lv_label name="header_pos_z" bind_text="motion_pos_z"/>
          <lv_obj name="header_pos_swap" width="1" height="1"/>
        </lv_obj>
      </header_bar-header_content>
    </header_bar>

    <lv_obj name="k3_motion_scroll"
            width="100%" height="0" flex_grow="1" style_pad_all="0" style_pad_bottom="140"
            style_bg_opa="0" style_border_width="0" scrollable="true" scroll_dir="ver"
            scrollbar_mode="off" flex_flow="column" style_pad_gap="12">
      <!-- K3 3-column Position Cards -->
      <lv_obj name="coord_row"
              width="100%" height="64" style_pad_all="0" style_bg_opa="0" style_border_width="0"
              scrollable="false" clickable="false" flex_flow="row" style_pad_gap="8">
        <lv_obj name="row_pos_x_group"
                width="0" height="64" flex_grow="1" clickable="true" style_pad_all="6"
                style_bg_opa="255" style_bg_color="#card_bg" style_border_width="1"
                style_border_color="#border" style_border_opa="150" style_radius="14"
                scrollable="false" flex_flow="column" style_flex_cross_place="center"
                style_flex_main_place="center" style_pad_gap="2">
          <event_cb trigger="clicked" callback="on_motion_pos_clicked" user_data="x"/>
          <bind_state_if_not_eq subject="nav_buttons_enabled" state="disabled" ref_value="1"/>
          <bind_state_if_eq subject="motion_x_homed" state="disabled" ref_value="0"/>
          <text_body name="row_pos_x_letter" text="Position X" style_text_font="noto_sans_12"
                     style_text_color="#text_muted" width="100%" style_text_align="center"
                     clickable="false" event_bubble="true"/>
          <text_body name="row_pos_x" text="" bind_text="motion_pos_x" style_text_font="noto_sans_bold_18"
                     style_text_color="#text" width="100%" style_text_align="center"
                     clickable="false" event_bubble="true"/>
        </lv_obj>
        <lv_obj name="row_pos_y_group"
                width="0" height="64" flex_grow="1" clickable="true" style_pad_all="6"
                style_bg_opa="255" style_bg_color="#card_bg" style_border_width="1"
                style_border_color="#border" style_border_opa="150" style_radius="14"
                scrollable="false" flex_flow="column" style_flex_cross_place="center"
                style_flex_main_place="center" style_pad_gap="2">
          <event_cb trigger="clicked" callback="on_motion_pos_clicked" user_data="y"/>
          <bind_state_if_not_eq subject="nav_buttons_enabled" state="disabled" ref_value="1"/>
          <bind_state_if_eq subject="motion_y_homed" state="disabled" ref_value="0"/>
          <text_body name="row_pos_y_letter" text="Position Y" style_text_font="noto_sans_12"
                     style_text_color="#text_muted" width="100%" style_text_align="center"
                     clickable="false" event_bubble="true"/>
          <text_body name="row_pos_y" text="" bind_text="motion_pos_y" style_text_font="noto_sans_bold_18"
                     style_text_color="#text" width="100%" style_text_align="center"
                     clickable="false" event_bubble="true"/>
        </lv_obj>
        <lv_obj name="row_pos_z_group"
                width="0" height="64" flex_grow="1" clickable="true" style_pad_all="6"
                style_bg_opa="255" style_bg_color="#card_bg" style_border_width="1"
                style_border_color="#border" style_border_opa="150" style_radius="14"
                scrollable="false" flex_flow="column" style_flex_cross_place="center"
                style_flex_main_place="center" style_pad_gap="2">
          <event_cb trigger="clicked" callback="on_motion_pos_clicked" user_data="z"/>
          <bind_state_if_not_eq subject="nav_buttons_enabled" state="disabled" ref_value="1"/>
          <bind_state_if_eq subject="motion_z_homed" state="disabled" ref_value="0"/>
          <text_body name="row_pos_z_letter" text="Position Z" style_text_font="noto_sans_12"
                     style_text_color="#text_muted" width="100%" style_text_align="center"
                     clickable="false" event_bubble="true"/>
          <text_body name="row_pos_z" text="" bind_text="motion_pos_z" style_text_font="noto_sans_bold_18"
                     style_text_color="#text" width="100%" style_text_align="center"
                     clickable="false" event_bubble="true"/>
        </lv_obj>
      </lv_obj>

      <lv_obj name="overlay_content"
              width="100%" height="content" style_pad_all="0" style_bg_opa="0" style_border_width="0"
              scrollable="false" flex_flow="column" style_pad_gap="12">
        <bind_state_if_not_eq subject="nav_buttons_enabled" state="disabled" ref_value="1"/>

        <!-- JOG TAB: K3 Homing + Axis Controls + Mode/Calibration cards -->
        <lv_obj name="k3_motion_jog_cards"
                width="100%" height="content" style_pad_all="0" style_bg_opa="0" style_border_width="0"
                scrollable="false" flex_flow="column" style_pad_gap="12">
          <bind_flag_if_not_eq subject="motion_tab" flag="hidden" ref_value="0"/>

          <!-- HOMING Card -->
          <lv_obj width="100%" height="108" style_pad_all="14" style_bg_opa="255" style_bg_color="#card_bg"
                  style_border_width="1" style_border_color="#border" style_border_opa="150"
                  style_radius="20" scrollable="false" flex_flow="column" style_pad_gap="4">
            <lv_obj width="100%" height="18" style_pad_all="0" style_bg_opa="0" style_border_width="0"
                    scrollable="false" flex_flow="row" style_flex_main_place="space_between"
                    style_flex_cross_place="center">
              <text_body text="HOMING" style_text_font="noto_sans_bold_14" style_text_color="#text_muted"
                         clickable="false" event_bubble="true"/>
              <lv_obj name="row_pos_swap"
                      width="content" height="18" clickable="true" style_pad_all="0" style_pad_gap="4"
                      style_bg_opa="0" style_border_width="0" scrollable="false" flex_flow="row"
                      style_flex_cross_place="center">
                <event_cb trigger="clicked" callback="on_motion_swap_coords_clicked"/>
                <icon src="swap_horizontal" size="xs">
                  <bind_style name="coords_swap_actual" subject="settings_motion_show_actual_position" ref_value="1"/>
                  <bind_style name="coords_swap_commanded" subject="settings_motion_show_actual_position" ref_value="0"/>
                </icon>
                <lv_label name="row_pos_swap_target" text="Target" style_text_font="noto_sans_12">
                  <bind_style name="coords_swap_commanded" subject="settings_motion_show_actual_position" ref_value="0"/>
                  <bind_flag_if_eq subject="settings_motion_show_actual_position" flag="hidden" ref_value="1"/>
                </lv_label>
                <lv_label name="row_pos_swap_actual" text="Actual" style_text_font="noto_sans_12">
                  <bind_style name="coords_swap_actual" subject="settings_motion_show_actual_position" ref_value="1"/>
                  <bind_flag_if_eq subject="settings_motion_show_actual_position" flag="hidden" ref_value="0"/>
                </lv_label>
              </lv_obj>
            </lv_obj>
            <lv_obj width="100%" height="58" style_pad_all="0" style_bg_opa="0" style_border_width="0"
                    scrollable="false" flex_flow="row" style_pad_gap="10">
              <ui_button name="k3_motion_home_all" text="All" height="58" width="0" flex_grow="1"
                         variant="ghost" style_bg_color="#k3_selected" style_bg_opa="255"
                         style_text_color="#text" style_text_font="noto_sans_bold_16"
                         style_border_width="0" style_radius="18" icon="home" moves_machine="true">
                <event_cb trigger="clicked" callback="on_motion_home" user_data="all"/>
                <bind_state_if_eq subject="controls_operation_in_progress" state="disabled" ref_value="1"/>
              </ui_button>
              <ui_button name="k3_motion_home_xy" text="XY" height="58" width="0" flex_grow="1"
                         variant="ghost" style_bg_color="#elevated_bg" style_bg_opa="255"
                         style_text_color="#text" style_text_font="noto_sans_bold_16"
                         style_border_width="0" style_radius="18" icon="home" moves_machine="true">
                <event_cb trigger="clicked" callback="on_motion_home" user_data="XY"/>
                <bind_state_if_eq subject="controls_operation_in_progress" state="disabled" ref_value="1"/>
              </ui_button>
              <ui_button name="k3_motion_home_z" text="Z" height="58" width="0" flex_grow="1"
                         variant="ghost" style_bg_color="#elevated_bg" style_bg_opa="255"
                         style_text_color="#text" style_text_font="noto_sans_bold_16"
                         style_border_width="0" style_radius="18" icon="home" moves_machine="true">
                <event_cb trigger="clicked" callback="on_motion_home" user_data="Z"/>
                <bind_state_if_eq subject="controls_operation_in_progress" state="disabled" ref_value="1"/>
              </ui_button>
            </lv_obj>
          </lv_obj>

          <!-- AXIS CONTROLS Card -->
          <lv_obj width="100%" height="422" style_pad_all="14" style_pad_top="16" style_pad_bottom="16"
                  style_pad_left="18" style_bg_opa="255" style_bg_color="#card_bg"
                  style_border_width="1" style_border_color="#border" style_border_opa="150"
                  style_radius="20" scrollable="false" flex_flow="column" style_pad_gap="0">
            <text_body text="AXIS CONTROLS" style_text_font="noto_sans_bold_14" style_text_color="#text_muted"
                       clickable="false" event_bubble="true" height="18"/>
            <lv_obj width="100%" height="58" style_pad_all="0" style_bg_opa="0" style_border_width="0"
                    scrollable="false" flex_flow="row" style_pad_gap="8">
              <ui_button name="k3_motion_step_5" text="5mm" height="58" width="0" flex_grow="1"
                         variant="ghost" style_bg_opa="255" style_text_color="#text"
                         style_text_font="noto_sans_bold_16" style_border_width="0" style_radius="18">
                <event_cb trigger="clicked" callback="k3_step" user_data="0"/>
                <bind_style_if_eq name="k3_step_selected" subject="k3_jog_step" ref_value="0"/>
                <bind_style_if_not_eq name="k3_step_unselected" subject="k3_jog_step" ref_value="0"/>
              </ui_button>
              <ui_button name="k3_motion_step_10" text="10mm" height="58" width="0" flex_grow="1"
                         variant="ghost" style_bg_opa="255" style_text_color="#text"
                         style_text_font="noto_sans_bold_16" style_border_width="0" style_radius="18">
                <event_cb trigger="clicked" callback="k3_step" user_data="1"/>
                <bind_style_if_eq name="k3_step_selected" subject="k3_jog_step" ref_value="1"/>
                <bind_style_if_not_eq name="k3_step_unselected" subject="k3_jog_step" ref_value="1"/>
              </ui_button>
              <ui_button name="k3_motion_step_25" text="25mm" height="58" width="0" flex_grow="1"
                         variant="ghost" style_bg_opa="255" style_text_color="#text"
                         style_text_font="noto_sans_bold_16" style_border_width="0" style_radius="18">
                <event_cb trigger="clicked" callback="k3_step" user_data="2"/>
                <bind_style_if_eq name="k3_step_selected" subject="k3_jog_step" ref_value="2"/>
                <bind_style_if_not_eq name="k3_step_unselected" subject="k3_jog_step" ref_value="2"/>
              </ui_button>
              <ui_button name="k3_motion_step_50" text="50mm" height="58" width="0" flex_grow="1"
                         variant="ghost" style_bg_opa="255" style_text_color="#text"
                         style_text_font="noto_sans_bold_16" style_border_width="0" style_radius="18">
                <event_cb trigger="clicked" callback="k3_step" user_data="3"/>
                <bind_style_if_eq name="k3_step_selected" subject="k3_jog_step" ref_value="3"/>
                <bind_style_if_not_eq name="k3_step_unselected" subject="k3_jog_step" ref_value="3"/>
              </ui_button>
            </lv_obj>
            <lv_obj width="1" height="16" style_pad_all="0" style_bg_opa="0" style_border_width="0"
                    scrollable="false" clickable="false"/>
            <lv_obj width="100%" height="224" style_pad_all="0" style_bg_opa="0" style_border_width="0"
                    scrollable="false" flex_flow="row" style_pad_gap="16">
              <lv_obj name="k3_motion_jog_wheel" width="224" height="224" style_pad_all="0"
                      style_bg_opa="0" style_border_width="0" scrollable="false">
                <lv_arc width="224" height="224" bg_start_angle="228" bg_end_angle="312"
                        style_arc_width="52" style_arc_color="#elevated_bg" style_arc_rounded="false"
                        style_arc_opa-indicator="0" style_bg_opa-knob="0" style_pad_all="0" clickable="false"/>
                <lv_arc width="224" height="224" bg_start_angle="318" bg_end_angle="42"
                        style_arc_width="52" style_arc_color="#elevated_bg" style_arc_rounded="false"
                        style_arc_opa-indicator="0" style_bg_opa-knob="0" style_pad_all="0" clickable="false"/>
                <lv_arc width="224" height="224" bg_start_angle="48" bg_end_angle="132"
                        style_arc_width="52" style_arc_color="#elevated_bg" style_arc_rounded="false"
                        style_arc_opa-indicator="0" style_bg_opa-knob="0" style_pad_all="0" clickable="false"/>
                <lv_arc width="224" height="224" bg_start_angle="138" bg_end_angle="222"
                        style_arc_width="52" style_arc_color="#elevated_bg" style_arc_rounded="false"
                        style_arc_opa-indicator="0" style_bg_opa-knob="0" style_pad_all="0" clickable="false"/>
                <ui_button name="k3_motion_jog_yplus" text="" height="64" width="64" variant="ghost"
                           style_bg_color="#elevated_bg" style_bg_opa="0" style_text_color="#text"
                           style_text_font="noto_sans_bold_16" style_border_width="0" style_radius="18"
                           icon="arrow_up" x="80" y="0" moves_machine="true">
                  <event_cb trigger="clicked" callback="k3_jog" user_data="y+"/>
                </ui_button>
                <ui_button name="k3_motion_jog_yminus" text="" height="64" width="64" variant="ghost"
                           style_bg_color="#elevated_bg" style_bg_opa="0" style_text_color="#text"
                           style_text_font="noto_sans_bold_16" style_border_width="0" style_radius="18"
                           icon="arrow_down" x="80" y="160" moves_machine="true">
                  <event_cb trigger="clicked" callback="k3_jog" user_data="y-"/>
                </ui_button>
                <ui_button name="k3_motion_jog_xminus" text="" height="64" width="64" variant="ghost"
                           style_bg_color="#elevated_bg" style_bg_opa="0" style_text_color="#text"
                           style_text_font="noto_sans_bold_16" style_border_width="0" style_radius="18"
                           icon="arrow_left" x="0" y="80" moves_machine="true">
                  <event_cb trigger="clicked" callback="k3_jog" user_data="x-"/>
                </ui_button>
                <ui_button name="k3_motion_jog_xplus" text="" height="64" width="64" variant="ghost"
                           style_bg_color="#elevated_bg" style_bg_opa="0" style_text_color="#text"
                           style_text_font="noto_sans_bold_16" style_border_width="0" style_radius="18"
                           icon="arrow_right" x="160" y="80" moves_machine="true">
                  <event_cb trigger="clicked" callback="k3_jog" user_data="x+"/>
                </ui_button>
                <ui_button name="k3_motion_jog_home" text="" height="80" width="80" variant="ghost"
                           style_bg_color="#k3_selected" style_bg_opa="255" style_text_color="#text"
                           style_text_font="noto_sans_bold_16" style_border_width="0" style_radius="40"
                           icon="home" x="72" y="72" moves_machine="true">
                  <event_cb trigger="clicked" callback="on_motion_home" user_data="all"/>
                </ui_button>
              </lv_obj>
              <lv_obj width="0" height="100%" flex_grow="1" style_pad_all="0" style_bg_opa="0"
                      style_border_width="0" scrollable="false" flex_flow="column" style_pad_gap="12">
                <ui_button name="k3_motion_jog_zplus" text="" height="0" width="100%" flex_grow="1"
                           variant="ghost" style_bg_color="#elevated_bg" style_bg_opa="255"
                           style_text_color="#text" style_text_font="noto_sans_bold_16"
                           style_border_width="0" style_radius="18" flex_flow="column" style_pad_gap="6"
                           moves_machine="true">
                  <event_cb trigger="clicked" callback="k3_jog" user_data="z+"/>
                  <icon src="arrow_up" size="sm" variant="text" clickable="false" event_bubble="true"/>
                  <text_body text="Z+" style_text_font="noto_sans_bold_16" style_text_color="#text"
                             clickable="false" event_bubble="true"/>
                </ui_button>
                <ui_button name="k3_motion_jog_zminus" text="" height="0" width="100%" flex_grow="1"
                           variant="ghost" style_bg_color="#elevated_bg" style_bg_opa="255"
                           style_text_color="#text" style_text_font="noto_sans_bold_16"
                           style_border_width="0" style_radius="18" flex_flow="column" style_pad_gap="6"
                           moves_machine="true">
                  <event_cb trigger="clicked" callback="k3_jog" user_data="z-"/>
                  <icon src="arrow_down" size="sm" variant="text" clickable="false" event_bubble="true"/>
                  <text_body text="Z-" style_text_font="noto_sans_bold_16" style_text_color="#text"
                             clickable="false" event_bubble="true"/>
                </ui_button>
              </lv_obj>
            </lv_obj>
            <lv_obj width="1" height="16" style_pad_all="0" style_bg_opa="0" style_border_width="0"
                    scrollable="false" clickable="false"/>
            <lv_obj width="100%" height="58" style_pad_all="0" style_bg_opa="0" style_border_width="0"
                    scrollable="false" flex_flow="row" style_pad_gap="10">
              <ui_button name="move_motors_off"
                         text="Disable Motors" height="58" width="0" flex_grow="1" variant="ghost"
                         style_bg_color="#elevated_bg" style_bg_opa="255" style_text_color="#text"
                         style_text_font="noto_sans_bold_14" style_border_width="0" style_radius="18"
                         moves_machine="true">
                <bind_state_if_eq subject="nav_buttons_enabled" state="disabled" ref_value="0"/>
                <event_cb trigger="clicked" callback="on_motion_motors_off_clicked"/>
              </ui_button>
              <ui_button name="move_park"
                         text="Park Toolhead" height="58" width="0" flex_grow="1" variant="ghost"
                         style_bg_color="#elevated_bg" style_bg_opa="255" style_text_color="#text"
                         style_text_font="noto_sans_bold_14" style_border_width="0" style_radius="18"
                         moves_machine="true">
                <bind_state_if_eq subject="nav_buttons_enabled" state="disabled" ref_value="0"/>
                <bind_state_if_eq subject="idle_timeout_printing" state="disabled" ref_value="1"/>
                <bind_state_if cond="motion_x_homed eq 0 or motion_y_homed eq 0 or motion_z_homed eq 0" state="disabled"/>
                <event_cb trigger="clicked" callback="on_motion_park_clicked"/>
              </ui_button>
            </lv_obj>
          </lv_obj>

          <!-- QUICK VIEWS & LEVELING Card -->
          <lv_obj name="bottom_row"
                  width="100%" height="content" style_pad_all="14" style_bg_opa="255" style_bg_color="#card_bg"
                  style_border_width="1" style_border_color="#border" style_border_opa="150"
                  style_radius="20" scrollable="false" flex_flow="column" style_pad_gap="8">
            <text_body text="QUICK VIEWS &amp; LEVELING" style_text_font="noto_sans_bold_14" style_text_color="#text_muted"
                       clickable="false" event_bubble="true" height="18"/>
            <lv_obj width="100%" height="58" style_pad_all="0" style_bg_opa="0" style_border_width="0"
                    scrollable="false" flex_flow="row" style_pad_gap="10">
              <ui_button name="k3_open_presets"
                         text="Preset Grid" icon="crosshairs_gps" height="58" width="0" flex_grow="1"
                         variant="ghost" style_bg_color="#elevated_bg" style_bg_opa="255"
                         style_text_color="#text" style_text_font="noto_sans_bold_14"
                         style_border_width="0" style_radius="18">
                <event_cb trigger="clicked" callback="on_motion_tab_clicked" user_data="1"/>
              </ui_button>
              <ui_button name="k3_open_bed_map"
                         text="Bed Map" icon="grid_large" height="58" width="0" flex_grow="1"
                         variant="ghost" style_bg_color="#elevated_bg" style_bg_opa="255"
                         style_text_color="#text" style_text_font="noto_sans_bold_14"
                         style_border_width="0" style_radius="18" moves_machine="true">
                <event_cb trigger="clicked" callback="on_motion_tab_clicked" user_data="2"/>
              </ui_button>
            </lv_obj>
            <lv_obj width="100%" height="content" style_pad_all="0" style_bg_opa="0" style_border_width="0"
                    scrollable="false" flex_flow="row" style_pad_gap="10">
              <ui_button name="btn_qgl"
                         text="Quad Gantry Level" icon="spirit_level" height="58" width="0" flex_grow="1"
                         variant="ghost" style_bg_color="#elevated_bg" style_bg_opa="255"
                         style_text_color="#text" style_text_font="noto_sans_bold_14"
                         style_border_width="0" style_radius="18" hidden="true" moves_machine="true">
                <bind_flag_if_eq subject="printer_has_qgl" flag="hidden" ref_value="0"/>
                <bind_state_if_eq subject="controls_operation_in_progress" state="disabled" ref_value="1"/>
                <event_cb trigger="clicked" callback="on_motion_qgl"/>
              </ui_button>
              <ui_button name="btn_z_tilt"
                         text="Z-Tilt Adjust" icon="spirit_level" height="58" width="0" flex_grow="1"
                         variant="ghost" style_bg_color="#elevated_bg" style_bg_opa="255"
                         style_text_color="#text" style_text_font="noto_sans_bold_14"
                         style_border_width="0" style_radius="18" hidden="true" moves_machine="true">
                <bind_flag_if_eq subject="printer_has_z_tilt" flag="hidden" ref_value="0"/>
                <bind_state_if_eq subject="controls_operation_in_progress" state="disabled" ref_value="1"/>
                <event_cb trigger="clicked" callback="on_motion_z_tilt"/>
              </ui_button>
            </lv_obj>
          </lv_obj>
        </lv_obj>

        <!-- MOVE TAB: Preset Positions Card -->
        <lv_obj name="move_tab"
                width="100%" height="460" style_pad_all="14" style_bg_opa="255" style_bg_color="#card_bg"
                style_border_width="1" style_border_color="#border" style_border_opa="150"
                style_radius="20" scrollable="false" flex_flow="column" style_pad_gap="10">
          <bind_flag_if_not_eq subject="motion_tab" flag="hidden" ref_value="1"/>
          <text_body text="TOOLHEAD PRESETS" style_text_font="noto_sans_bold_14" style_text_color="#text_muted"
                     clickable="false" event_bubble="true" height="18"/>
          <lv_obj width="100%" height="0" flex_grow="1" style_pad_all="0" style_bg_opa="0"
                  style_border_width="0" scrollable="false">
            <move_preset_grid actions="false"/>
          </lv_obj>
        </lv_obj>

        <!-- BED TAB: Interactive Bed Map Card -->
        <lv_obj name="bed_tab"
                width="100%" height="460" style_pad_all="14" style_bg_opa="255" style_bg_color="#card_bg"
                style_border_width="1" style_border_color="#border" style_border_opa="150"
                style_radius="20" scrollable="false" flex_flow="column" style_pad_gap="10">
          <bind_flag_if_not_eq subject="motion_tab" flag="hidden" ref_value="2"/>
          <text_body text="BED PLATE MAP" style_text_font="noto_sans_bold_14" style_text_color="#text_muted"
                     clickable="false" event_bubble="true" height="18"/>
          <lv_obj width="100%" height="0" flex_grow="1" style_pad_all="0" style_bg_opa="0"
                  style_border_width="0" scrollable="false">
            <motion_bed_map/>
          </lv_obj>
        </lv_obj>

        <!-- Hidden upstream jog_pad_container & z_column for MotionPanel::setup_jog_pad() compatibility -->
        <lv_obj name="pad_row"
                width="240" height="240" hidden="true" style_pad_all="0" style_border_opa="0"
                scrollable="false" flex_flow="row">
          <lv_obj name="jog_pad_wrapper"
                  width="200" height="200" style_pad_all="0" style_border_opa="0" scrollable="false">
            <lv_obj name="jog_pad_container"
                    width="content" height="content" style_pad_all="0" style_border_opa="0"
                    scrollable="false" clickable="true" align="left_mid"/>
          </lv_obj>
          <lv_obj name="jog_layout_slot" width="1" height="1" hidden="true" scrollable="false">
            <motion_jog_layout/>
          </lv_obj>
          <lv_obj name="z_column" height="100%" style_min_width="#motion_z_col_w" flex_grow="1"
                  style_pad_all="0" style_border_opa="0" scrollable="false" flex_flow="column">
            <motion_jog_button name="z_up_large" width="100%" jog="z_up_large" flex_grow="1"
                               icon="arrow_up" bind_icon="motion_z_up_icon" label="motion_jog_outer_label"/>
            <motion_jog_button name="z_up_small" width="100%" jog="z_up_small" flex_grow="1"
                               icon="arrow_up" bind_icon="motion_z_up_icon" label="motion_jog_inner_label"/>
            <text_body name="z_axis_label" width="100%" bind_text="motion_z_axis_label" style_text_align="center"/>
            <motion_jog_button name="z_down_small" width="100%" jog="z_down_small" flex_grow="1"
                               icon="arrow_down" bind_icon="motion_z_down_icon" label="motion_jog_inner_label"/>
            <motion_jog_button name="z_down_large" width="100%" jog="z_down_large" flex_grow="1"
                               icon="arrow_down" bind_icon="motion_z_down_icon" label="motion_jog_outer_label"/>
          </lv_obj>
          <motion_jog_modes name="jog_modes" width="1" hidden="true"/>
        </lv_obj>
      </lv_obj>
    </lv_obj>
  </view>
</component>
