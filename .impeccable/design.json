  "narrative": {
    "northStar": "",
    "overview": "HelixScreen K3 extends the existing native embedded Linux/LVGL interface. Charcoal surfaces, violet actions and pale lavender icons follow the user’s portrait reference while retaining the upstream component vocabulary, typography and broad printer functionality.\n\nThe visual character is compact, calm and operational. Group related readings and actions in clear tonal containers; reserve semantic colors for the state or command they communicate. This documents the implemented K3 theme and portrait extension, not a replacement identity for upstream HelixScreen.",
    "keyCharacteristics": [
      "Charcoal tonal surfaces with violet action emphasis.",
      "Native Noto Sans text and Material Design Icons.",
      "Full-width portrait groups with reachable scrolling content.",
      "Existing command handlers, feature discovery and machine guards."
    ],
    "rules": [
      {
        "name": "Semantic State",
        "body": "Use danger, warning, success and info for their existing state meanings; violet identifies ordinary primary actions.",
        "section": "colors"
      },
      {
        "name": "Native Hierarchy",
        "body": "Reuse upstream responsive font tokens and MDI assets; do not introduce web fonts, a new display face or an unrelated icon family.",
        "section": "typography"
      },
      {
        "name": "Tonal Depth",
        "body": "Separate resting surfaces with the existing background ladder and borders; the K3 preset has no visible drop shadows.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do keep the Emergency action above the portrait Controls scroll container.",
      "Do let quick macro content determine its card height.",
      "Do use runtime responsive tokens and existing native components.",
      "Do preserve user-edited home layouts, other resolution defaults and command guards.",
      "Do review both first-view and scrolled content at the target resolution."
    ],
    "donts": [
      "Don’t apply the 400×1280 home grid to every display.",
      "Don’t treat mock screenshots as physical touch, printer or display validation.",
      "Don’t replace semantic state colors with violet for decoration.",
      "Don’t turn incidental truncation, clipping or a transient mock value into a design rule."
    ]
  },
